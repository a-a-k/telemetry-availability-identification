  "semantic_dimensions": [
    {
      "id": "trace_ingestion",
      "required_work_if_absent": "Implement and validate a transparent adapter from preserved M7 OpenTelemetry/native evidence to the pinned Jaeger-shaped reader contract."
    },
    {
      "id": "architecture_operation_flow",
      "required_work_if_absent": "Adapt component detection and retain source-grounded operation, call, usage, allocation, and resource semantics for both applications."
    },
    {
      "id": "software_operation_failure",
      "required_work_if_absent": "Instrument or map operation failures to the exact error-tag contract and verify the generated internal failure probability."
    },
    {
      "id": "host_lifecycle",
      "required_work_if_absent": "Estimate host/domain lifecycle and map MTTF/MTTR from eligible learner evidence without evaluator leakage."
    },
    {
      "id": "communication_failure",
      "required_work_if_absent": "Estimate and map communication failure separately from operation failures and latency."
    },
    {
      "id": "replication",
      "required_work_if_absent": "Recover interchangeable replicas and explicit paths rather than interpreting arbitrary component multiplicity as redundancy."
    },
    {
      "id": "common_failure_domains",
      "required_work_if_absent": "Represent colocated and split logical failure domains explicitly and audit their transfer assumptions."
    },
    {
      "id": "external_client_success",
      "required_work_if_absent": "Add the frozen external-client success contract and semantic residual without treating every unmarked span as client success."
    }
  ],
